rules_version = '2';

// Reglas de Firestore de RapidDash. Todo lo que no se permite aquí está prohibido.
// Desplegar (reglas e índices): npx -y firebase-tools@latest deploy --only firestore --project rapiddash-gabo
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function nicknameDoc(key) {
      return /databases/$(database)/documents/nicknames/$(key);
    }

    // Perfil público del piloto: apodo, país y fechas. Cada uno solo escribe el suyo.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['nickname', 'nicknameKey', 'country', 'createdAt', 'linkReminderAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 3
        && request.resource.data.nickname.size() <= 16
        && (request.resource.data.country == null
          || request.resource.data.country.matches('^[A-Z]{2}$'))
        // El apodo tiene que estar reservado a su nombre al terminar la escritura
        && getAfter(nicknameDoc(request.resource.data.nicknameKey)).data.uid == uid;
      allow delete: if false;
    }

    // Ranking: el récord de cada piloto en cada mapa. Solo se puede mejorar (o sustituir por uno
    // de una física más nueva) y lleva el apodo y el país del perfil. Los límites de tiempo son
    // los de core/domain/race/cloud-record.ts.
    match /records/{mapId}/runs/{uid} {
      function validRun() {
        let run = request.resource.data;
        let profile = get(/databases/$(database)/documents/users/$(uid)).data;
        return signedIn()
          && request.auth.uid == uid
          && mapId.matches('^[A-Za-z0-9-]{1,40}$')
          && run.keys().hasOnly(['nickname', 'country', 'time', 'physicsVersion', 'recordedAt'])
          && run.time is number && run.time > 10 && run.time < 3600
          && run.physicsVersion is int && run.physicsVersion >= 1
          && run.recordedAt == request.time
          && run.nickname == profile.nickname
          && run.country == profile.country;
      }

      allow read: if signedIn();
      allow create: if validRun();
      allow update: if (validRun()
          && (request.resource.data.physicsVersion > resource.data.physicsVersion
            || (request.resource.data.physicsVersion == resource.data.physicsVersion
              && request.resource.data.time < resource.data.time)))
        // Al cambiar el apodo o el país en el perfil: solo esos dos campos, iguales al perfil
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'country'])
          && request.resource.data.nickname
            == get(/databases/$(database)/documents/users/$(uid)).data.nickname
          && request.resource.data.country
            == get(/databases/$(database)/documents/users/$(uid)).data.country);
      allow delete: if false;
    }

    // Fantasma de cada récord (id: {mapa}__{uid}). Se escribe junto al récord y debe coincidir.
    match /ghosts/{ghostId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['mapId', 'uid', 'time', 'physicsVersion', 'frames'])
        && request.resource.data.uid == request.auth.uid
        && ghostId == request.resource.data.mapId + '__' + request.auth.uid
        && request.resource.data.frames is string
        && request.resource.data.frames.size() < 500000
        && getAfter(/databases/$(database)/documents/records/$(request.resource.data.mapId)/runs/$(request.auth.uid)).data.time
          == request.resource.data.time;
      allow delete: if false;
    }

    // Torneos (id = código): 3 días, hasta 20 pilotos. Unirse solo antes de empezar; empezar,
    // solo el creador, con al menos 2 pilotos, a la hora del servidor y con los 3 mapas.
    match /tournaments/{code} {
      allow get: if signedIn();
      // «Mis torneos»: solo se pueden listar aquellos en los que estoy
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(
          ['name', 'ownerUid', 'members', 'memberUids', 'startedAt', 'mapIds', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].uid == request.auth.uid
        && request.resource.data.startedAt == null
        && request.resource.data.mapIds.size() == 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        // Unirse: añado solo mi uid y mi ficha, antes de empezar y sin pasar de 20
        (resource.data.startedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.members.size() == request.resource.data.memberUids.size()
          && request.resource.data.memberUids.size() <= 20)
        // Empezar: solo el creador
        || (resource.data.ownerUid == request.auth.uid
          && resource.data.startedAt == null
          && resource.data.memberUids.size() >= 2
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startedAt', 'mapIds'])
          && request.resource.data.startedAt == request.time
          && request.resource.data.mapIds.size() == 3));
      allow delete: if false;

      // Foto del cartel del líder (id = uid): solo la ven los miembros y cada uno sube o borra
      // la suya. JPEG en data URL de como mucho 140 000 caracteres (core/domain/tournament/leader-photo.ts).
      match /photos/{uid} {
        function isMember() {
          return request.auth.uid
            in get(/databases/$(database)/documents/tournaments/$(code)).data.memberUids;
        }
        allow read: if signedIn() && isMember();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isMember()
          && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 140000
          && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Reserva de apodos únicos: el id es el apodo sin mayúsculas ni tildes.
    match /nicknames/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key.size() >= 3
        && key.size() <= 16;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
